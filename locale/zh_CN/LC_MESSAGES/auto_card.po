msgstr "{path}：职业 '{role_id}' 的 starting_hp 高于 max_hp。"

msgid "{path}: role '{role_id}' reward pool must contain at least {card_count} cards."
msgstr "{path}：职业 '{role_id}' 的奖励池必须至少包含 {card_count} 张卡。"

msgid "{path}: role '{role_id}' starting_collection references unknown cards {card_ids}."
msgstr "{path}：职业 '{role_id}' 的 starting_collection 引用了未知卡牌：{card_ids}。"

msgid "{path}: role '{role_id}' starting_deck must contain exactly {deck_size} cards."
msgstr "{path}：职业 '{role_id}' 的 starting_deck 必须恰好包含 {deck_size} 张卡。"

msgid "{path}: role '{role_id}' starting_deck references unknown cards {card_ids}."
msgstr "{path}：职业 '{role_id}' 的 starting_deck 引用了未知卡牌：{card_ids}。"

msgid "{path}: role '{role_id}' starting_deck uses more copies than owned for {card_ids}."
msgstr "{path}：职业 '{role_id}' 的 starting_deck 对这些卡牌的使用数量超过持有数量：{card_ids}。"

msgid "{path}: roles must be an array of tables."
msgstr "{path}：roles 必须是表数组。"

msgid "{path}: roles[{index}] must be a table."
msgstr "{path}：roles[{index}] 必须是表。"

msgid "{path}: root must be a TOML table."
msgstr "{path}：根节点必须是 TOML 表。"

msgid "{path}: total_battle_count must equal normal_battle_count + 1."
msgstr "{path}：total_battle_count 必须等于 normal_battle_count + 1。"

msgid "{path}: unknown boss_enemy_id '{enemy_id}'."
msgstr "{path}：未知的 boss_enemy_id '{enemy_id}'。"

msgid "{path}: unknown default_role_id '{role_id}'."
msgstr "{path}：未知的 default_role_id '{role_id}'。"

msgid "{path}: unknown normal_enemy_ids {enemy_ids}."
msgstr "{path}：未知的 normal_enemy_ids {enemy_ids}。"

msgid "{role_name}\nBattle {battle_number}/{total_battles}\nHP {hp}/{max_hp}\nArmor {armor}\nStatus {statuses}"
msgstr "{role_name}\n战斗 {battle_number}/{total_battles}\n生命 {hp}/{max_hp}\n护甲 {armor}\n状态 {statuses}"

msgid "{role_name} ({role_id})\nBattle {battle_number}/{total_battles} vs {enemy_name} ({enemy_id}) ({battle_type})\nHP {current_hp}/{max_hp} | Deck {selected_count}/{deck_size}"
msgstr "{role_name} ({role_id})\n战斗 {battle_number}/{total_battles} 对阵 {enemy_name} ({enemy_id})（{battle_type}）\n生命 {current_hp}/{max_hp} | 卡组 {selected_count}/{deck_size}"

msgid "{role_name} ({role_id})\nHP {current_hp}/{max_hp}\nBattle {battle_number} cleared against {enemy_name}\nNext: {next_text}"
msgstr "{role_name} ({role_id})\n生命 {current_hp}/{max_hp}\n已通过对抗 {enemy_name} 的第 {battle_number} 场战斗\n下一步：{next_text}"
